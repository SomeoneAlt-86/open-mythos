{
  "name": "open-mythos",
  "version": "0.1.0",
  "description": "Automated LLM-assisted vulnerability discovery pipeline",
  "keywords": [
    "llm",
    "ai",
    "security",
    "vulnerability",
    "static-analysis",
    "agent",
    "pentest",
    "recon"
  ],
  "homepage": "https://github.com/SomeoneAlt-86/open-mythos#readme",
  "bugs": {
    "url": "https://github.com/SomeoneAlt-86/open-mythos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SomeoneAlt-86/open-mythos.git"
  },
  "license": "MIT",
  "author": "S. Sidhu",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
